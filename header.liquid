{%- assign pn_announcement = section.settings.announcement -%}{%- if pn_announcement == blank -%}{%- assign pn_announcement = 'sections.header.announcement' | t -%}{%- endif -%}{%- assign pn_tagline = section.settings.tagline -%}{%- if pn_tagline == blank -%}{%- assign pn_tagline = 'sections.header.tagline' | t -%}{%- endif -%}{%- assign pn_drawer_text = section.settings.drawer_text -%}{%- if pn_drawer_text == blank -%}{%- assign pn_drawer_text = 'sections.header.drawer_text' | t -%}{%- endif -%}
{%- comment -%}
  09/11 (campanha-novembro-2026): faixa de cima com os descontos automáticos e o período (DL 70/2007).
  10 a 23/11: −15% artigos e −30% PDF. 24 a 30/11 (Black Week): −20% e −40%.
  Os descontos estão em Shopify → Descontos, etiqueta campanha-novembro-2026.
  O script escolhe a fase pela data, o que corrige páginas em cache. Para testar antes do dia 10, juntar ?pn_campanha=nov ou ?pn_campanha=bw ao endereço.
  O data-pn-natal no link impede o assets/pn-digitais.js de trocar esta faixa pela do Natal. A 1/12 esta faixa sai e volta a do Natal.
{%- endcomment -%}
{%- comment -%} 11/11 (auditoria): textos da campanha em PT, EN e ES (antes apareciam em português em /en e /es). {%- endcomment -%}
{%- liquid
  assign pnc_lg = request.locale.iso_code | slice: 0, 2
  case pnc_lg
    when 'en'
      assign pnc_nov = '<strong>−15% on almost everything in the shop and −30% on PDFs</strong> · 10 to 23 November · discount already applied in your bag'
      assign pnc_bw = '<strong>Black Week: −20% on almost everything in the shop and −40% on PDFs</strong> · 24 to 30 November · discount already applied in your bag'
      assign pnc_ate_nov = 'until 23 November'
      assign pnc_ate_bw = 'until 30 November'
      assign pnc_with = 'With the discount it costs'
      assign pnc_applied = 'applied in your bag'
      assign pnc_excl = 'Special price · not included in the promotion'
      assign pnc_last = 'last day'
      assign pnc_left = '[n] days left'
    when 'es'
      assign pnc_nov = '<strong>−15% en casi toda la tienda y −30% en los PDF</strong> · del 10 al 23 de noviembre · descuento ya aplicado en la cesta'
      assign pnc_bw = '<strong>Black Week: −20% en casi toda la tienda y −40% en los PDF</strong> · del 24 al 30 de noviembre · descuento ya aplicado en la cesta'
      assign pnc_ate_nov = 'hasta el 23 de noviembre'
      assign pnc_ate_bw = 'hasta el 30 de noviembre'
      assign pnc_with = 'Con el descuento se queda en'
      assign pnc_applied = 'aplicado en la cesta'
      assign pnc_excl = 'Precio especial · no incluido en la promoción'
      assign pnc_last = 'último día'
      assign pnc_left = 'quedan [n] días'
    else
      assign pnc_nov = '<strong>−15% em quase toda a loja e −30% nos PDF</strong> · de 10 a 23 de novembro · desconto já aplicado no saco'
      assign pnc_bw = '<strong>Black Week: −20% em quase toda a loja e −40% nos PDF</strong> · de 24 a 30 de novembro · desconto já aplicado no saco'
      assign pnc_ate_nov = 'até 23 de novembro'
      assign pnc_ate_bw = 'até 30 de novembro'
      assign pnc_with = 'Com o desconto fica por'
      assign pnc_applied = 'aplicado no saco'
      assign pnc_excl = 'Preço especial · não incluído na campanha'
      assign pnc_last = 'último dia'
      assign pnc_left = 'faltam [n] dias'
  endcase
-%}
