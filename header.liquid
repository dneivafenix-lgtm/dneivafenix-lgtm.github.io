<style>
  .pn-48{display:flex;align-items:center;gap:8px;margin:12px 0 4px;font-size:14px;line-height:1.4;font-weight:600;color:#3d6b4c}
  .pn-48::before{content:"";flex:none;width:8px;height:8px;border-radius:50%;background:#4f9a5b;box-shadow:0 0 0 3px rgba(79,154,91,.18)}
  .pn-48[hidden]{display:none}
</style>
<script>
  (function () {
    {%- comment -%} 09/11 noite (fix EN/ES portes): textos em PT, EN e ES {%- endcomment -%}
    {%- assign pn48_l = request.locale.iso_code | slice: 0, 2 -%}
    var I = {%- case pn48_l -%}{%- when 'en' -%}{ t: 'In stock · delivered within 48 business hours in mainland Portugal', lab: '48-hour delivery', a: 'CTT shipping ', b: 'Shipping ' }{%- when 'es' -%}{ t: 'En stock · entrega en 48 horas laborables en Portugal continental', lab: 'Entrega en 48 h', a: 'Envío CTT ', b: 'Envío ' }{%- else -%}{ t: 'Em stock · entrega em 48 horas úteis em Portugal continental', lab: 'Entrega em 48 h', a: 'Envio CTT ', b: 'Envio ' }{%- endcase -%};
    var T = I.t, PAGE = {{ pn48_pg | json }}, WEAR = {{ pn48_w | json }};
    var OK = { meal: 1, play: 1, care: 1, pack: 1 }, last = false;
    var cardOk = function (c) { var w = c.closest('.card-wrap'); return !!OK[c.getAttribute('data-category')] && !(w && w.hasAttribute('data-mto')); };
    document.addEventListener('click', function (e) { var c = e.target.closest && e.target.closest('[data-product-card]'); if (c) last = cardOk(c); }, true);
    var modalCard = function () {
      var a = document.querySelector('#detailContent a.kit-link[href*="/products/"]');
      return a ? document.getElementById('produto-' + (a.getAttribute('href').split('/products/')[1] || '').split(/[?#]/)[0]) : null;
    };
    var modalOk = function () { var c = modalCard(); return c ? cardOk(c) : last; };
    var noCtt = function (el) { if (el && el.textContent.indexOf(I.a) === 0) el.textContent = el.textContent.replace(I.a, I.b); };
    var mk = function () { var p = document.createElement('p'); p.className = 'pn-48'; p.setAttribute('data-pn-48', ''); p.textContent = T; return p; };
    var put = function (btn, show) {
      if (!btn) return;
      var p = btn.nextElementSibling;
      for (var i = 0; p && i < 4 && !p.hasAttribute('data-pn-48'); i++) p = p.nextElementSibling;
      if (!p || !p.hasAttribute('data-pn-48')) {
        if (!show) return;
        var a = btn; while (a.nextElementSibling && a.nextElementSibling.matches('.pn-pv-tag,.pn-montra-pill')) a = a.nextElementSibling;
        p = mk(); a.insertAdjacentElement('afterend', p);
      }
      p.hidden = !show || btn.disabled;
    };
    var paint = function () {
      var d = document.querySelector('#detailContent p.pn-shipping');
      put(document.querySelector('#detail [data-quick-add]'), !!d && !d.hasAttribute('data-pn-digital') && modalOk());
      var mc = d && modalCard(); if (mc && mc.getAttribute('data-category') === 'wear') noCtt(d);
      if (PAGE) put(document.getElementById('productAdd'), true);
      if (WEAR) noCtt(document.querySelector('.pn-product__info p.pn-shipping'));
      document.querySelectorAll('[data-kit-form] button.primary').forEach(function (b) { put(b, true); });
    };
    var t = 0, later = function () { if (t) return; t = setTimeout(function () { t = 0; paint(); }, 60); };
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('#products .card-wrap > article.card[data-category="wear"]').forEach(function (a) { a.parentElement.setAttribute('data-mto', ''); });
      var lab = document.querySelector('[data-pn-stock-toggle] .pn-stock-toggle__text'); if (lab) lab.textContent = I.lab;
      paint();
      new MutationObserver(later).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['disabled'] });
    });
  })();
</script>
