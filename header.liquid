  .pn-montra-pill.pn-pv-pill{white-space:normal;height:auto;line-height:1.25;padding-top:6px;padding-bottom:6px;text-align:center;max-width:100%}
</style>
<script>
  (function () {
    if (new Date() >= new Date('2026-11-09T23:03:00Z')) return;
    var T = { pill: {{ pn_pv_pill | json }}, tag: {{ pn_pv_tag | json }} }, PAGE = {{ pn_pv_page | json }};
    var MC = { meal: 1, play: 1, care: 1, pack: 1 }, lastMushie = false;
    var cardIsMushie = function (c) { var w = c.closest('.card-wrap'); return !!MC[c.dataset.category] && !(w && w.hasAttribute('data-mto')); };
    var isMushie = function (el) {
      var c = el.closest('[data-product-card]'); if (c) return cardIsMushie(c);
      if (el.closest('[data-kit-form]')) return true;
      if (el.closest('#detail')) return lastMushie;
      if (el.closest('#ProductForm') || el.id === 'productAdd') return PAGE;
      return false;
    };
    document.addEventListener('click', function (e) { var c = e.target.closest && e.target.closest('[data-product-card]'); if (c) lastMushie = cardIsMushie(c); }, true);
    var addTag = function (after) { var n = after.nextElementSibling; while (n && n.classList.contains('pn-montra-pill')) n = n.nextElementSibling; if (n && n.classList.contains('pn-pv-tag')) return; var t = document.createElement('p'); t.className = 'pn-pv-tag'; t.textContent = T.tag; after.insertAdjacentElement('afterend', t); };
    var paint = function () {
      if (document.documentElement.classList.contains('pn-montra')) {
        document.querySelectorAll('.pn-montra-pill').forEach(function (p) { if (isMushie(p) && p.textContent !== T.pill) { p.textContent = T.pill; p.classList.add('pn-pv-pill'); } });
        return;
      }
      /* 05/11: a nota já não aparece nos cartões da grelha; fica só dentro do cartão aberto, no kit e na página do produto. */
      document.querySelectorAll('#detail [data-quick-add],[data-kit-form] button.primary,#productAdd').forEach(function (b) { if (isMushie(b)) addTag(b); });
    };
    var timer = 0, q = function () { if (timer) return; timer = setTimeout(function () { timer = 0; paint(); }, 20); };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', paint); else paint();
    window.addEventListener('load', paint);
    new MutationObserver(q).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>

