    ];
    var G = /gr[áa]tis|free/i, S = /envio|envío|portes|shipping/i;
    var rep = function (t) { for (var i = 0; i < R.length; i++) t = t.replace(R[i][0], R[i][1]); return t; };
    var fix = function (root) {
      if (!root) return;
      var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT), x;
      while ((x = w.nextNode())) {
        var v = x.nodeValue; if (!G.test(v) || !S.test(v)) continue;
        var e = x.parentElement; if (!e || e.closest('script,style') || (LEGAL && e.closest('#MainContent'))) continue;
        if (e.closest('#cart')) { if (!e.closest('#pnFrete')) e.hidden = true; continue; }
        var r = rep(v); if (r !== v) x.nodeValue = r;
      }
    };
    var t = 0;
    document.addEventListener('DOMContentLoaded', function () {
      fix(document.body);
      new MutationObserver(function () { clearTimeout(t); t = setTimeout(function () { fix(document.body); }, 120); }).observe(document.body, { childList: true, subtree: true, characterData: true });
    });
  })();
</script>
{%- comment -%}
  09/11 (entrega-48h): «Em stock · entrega em 48 horas úteis em Portugal continental» logo a seguir ao botão de compra, nos artigos em stock: Mushie, packs e kit.
  Não aparece na roupa (vem do parceiro de produção), nos PDF nem nos artigos «Por encomenda». Esconde-se se a cor escolhida estiver esgotada.
  Também muda o interruptor da grelha para «Entrega em 48 h» e tira de lá a roupa (marca os cartões de roupa com data-mto, que é o que o interruptor esconde).
  Na roupa e no calçado, tira «CTT» da linha dos portes («Envio 4,90 € · …»), porque a roupa não segue pelos CTT.
  Ligado à Política de envio (secção 3) e às taxas Padrão e Grátis em Definições → Envio e entrega.
{%- endcomment -%}
