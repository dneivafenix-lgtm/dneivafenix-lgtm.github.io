{%- if pn_hoje_c >= 20261109 and pn_hoje_c <= 20261130 -%}
  {%- comment -%}
    09/11 (campanha-novembro-2026, portes): até 30/11 o envio é grátis em Portugal continental a partir de 39 € (tarifas em Envio e entrega; nota na Política de envio).
    Este script troca «a partir de 49 €» / «acima de 49 €» por 39 € nos textos do site (faixas, rodapé, página do produto, janela do artigo, saco). Não mexe nas páginas das políticas.
    09/11 noite (fix EN/ES portes): também troca o inglês («from €49», «over €49», «above €49») e o espanhol («a partir de 49 €», «desde 49 €», «más de 49 €»), para PT, EN e ES ficarem iguais.
    O limite da barra do saco e do «Junta ao teu pedido» vem do «free» do #pnUpsell (snippets/cart-drawer.liquid). A 1/12 tudo volta aos 49 € sozinho, menos as tarifas, que têm de ser repostas.
  {%- endcomment -%}
  <script>
    (function () {
      if (Date.now() >= Date.UTC(2026, 11, 1)) return;
      /* 09/11 noite: nas políticas e nas páginas legais em espanhol (também em /en/ e /es/) o texto principal fica como está (já explica 39 € até 30/11 e 49 € depois); só as faixas e o rodapé passam a 39 €. */
      var LEGAL = /\/policies\/|\/pages\/(envios|condiciones-generales|aviso-legal|devoluciones-y-desistimiento|privacidad)(\/|$)/.test(location.pathname);
      var inMain = function (n) { var e = n.parentElement; return !!(e && e.closest('#MainContent')); };
      var re = /(a partir de |acima de |desde |más de )49(\s| )?€/g, reEn = /(from |over |above )€(\s| )?49(?![\d.,]*\d)/g;
      var rep = function (s) { return s.replace(re, function (m, a, sp) { return a + '39' + (sp || ' ') + '€'; }).replace(reEn, function (m, a, sp) { return a + '€' + (sp || '') + '39'; }); };
      var fix = function (root) {
        if (!root) return;
        var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT), n;
        while ((n = w.nextNode())) { if (n.nodeValue.indexOf('49') > -1 && !(LEGAL && inMain(n))) { var v = rep(n.nodeValue); if (v !== n.nodeValue) n.nodeValue = v; } }
        if (root.querySelectorAll) root.querySelectorAll('[data-shipping]').forEach(function (e) { var a = e.getAttribute('data-shipping'), b = rep(a); if (a !== b) e.setAttribute('data-shipping', b); });
      };
      var t = 0;
      document.addEventListener('DOMContentLoaded', function () {
        fix(document.body);
        new MutationObserver(function () { clearTimeout(t); t = setTimeout(function () { fix(document.getElementById('detail')); fix(document.getElementById('cart')); }, 80); }).observe(document.body, { childList: true, subtree: true });
      });
    })();
  </script>
