{%- comment -%}
  06/11 (popup-news-0611): pop-up de subscrição da newsletter (antes com 10%, código BEMVINDO10).
  21/11 (sem BEMVINDO10): o código acaba a 23/11; os textos padrão (data-pnp-std) passam a convite neutro à newsletter, sem 10% nem código. Os textos da Black Week (data-pnp-bw) não mudam.
  - Abre ao fim de 15 s ou a meio da página, uma vez a cada 14 dias por visitante.
  - Não abre no carrinho, na conta, nem se outra janela do site estiver aberta (jogo, abertura).
  - Depois de subscrever, a página volta com a janela aberta e o código à vista.
  - 09/11 (campanha-novembro-2026): de 10 a 30/11 a janela troca o 10% pelo aviso da Black Week (blocos data-pnp-bw), porque o 10% não se soma aos descontos da campanha. Etiqueta popup-blackweek. Testar: ?popup=teste&pn_campanha=nov.
  - 10/11 (saco + popup): em ecrãs ≤640 px a janela passa a folha inferior NÃO modal (dialog.show), para não tapar o «+» da grelha; no desktop mantém-se showModal. Textos em PT/EN/ES. Testar: ?popup=teste.
  - 16/11 (popup vs barra): na página de produto, se a barra de compra (.pn-barra.is-on) estiver visível, a folha sobe (bottom = altura da barra + folga) e fica à frente (z-index 50). Não tapa o botão da barra; na home não há barra, o «+» mantém-se à vista. Testar: ?popup=teste numa página de produto a 390 px.
  - 22/11 (scroll preso): no telemóvel, a folha aberta deixava a página sem scroll (regra body:has(dialog[open]) do theme.css). Corrigido no CSS abaixo.
  - Testar: ?popup=teste. Para desligar: apagar a linha render 'pn-popup-news' em layout/theme.liquid.
{%- endcomment -%}
{%- liquid
  assign pnp_code = 'BEMVINDO10'
  assign pnp_skip = false
  if request.page_type == 'cart' or template.name == 'customers' or request.path contains '/account' or request.page_type == 'password'
    assign pnp_skip = true
  endif
  assign pnp_lang = request.locale.iso_code | slice: 0, 2
  case pnp_lang
    when 'en'
      assign pnp_close = 'Close'
      assign pnp_ok_t = 'Welcome to the cloud!'
      assign pnp_ok_p = 'Thank you for subscribing. We’ll send you news and exclusive offers.'
      assign pnp_ok_bw = 'Deal: we will email you when Black Week starts, on 24 November. Until then you already have −15% on almost everything in the shop and −30% on PDFs, applied in the bag.'
      assign pnp_copy = 'Copy code'
      assign pnp_copied = 'Copied ✓'
      assign pnp_shop = 'Shop the collection'
      assign pnp_valid = 'Valid once per customer. Apply it at checkout.'
      assign pnp_kicker = 'Join the cloud'
      assign pnp_t = 'News and exclusive offers'
      assign pnp_t_bw = 'We will tell you when Black Week starts'
      assign pnp_p = 'Subscribe to our newsletter and get news and exclusive offers, plus ideas for your baby’s first years.'
      assign pnp_p_bw = 'From 24 to 30 November: −20% on almost everything in the shop and −40% on PDFs. Leave your email and we will tell you on the day, with news and ideas for your baby’s first years.'
      assign pnp_ph = 'Your email'
      assign pnp_btn = 'Subscribe'
      assign pnp_btn_bw = 'Notify me'
      assign pnp_legal = 'By subscribing you agree to receive emails from Petit Nuvem. You can unsubscribe at any time.'
      assign pnp_privacy = 'Privacy policy'
      assign pnp_no = 'Not now'
    when 'es'
      assign pnp_close = 'Cerrar'
      assign pnp_ok_t = '¡Bienvenida a la nube!'
      assign pnp_ok_p = 'Gracias por suscribirte. Te enviaremos novedades y ofertas exclusivas.'
      assign pnp_ok_bw = 'Trato hecho: te avisamos por email cuando empiece la Black Week, el 24 de noviembre. Hasta entonces ya tienes −15% en casi toda la tienda y −30% en los PDF, aplicado en la cesta.'
      assign pnp_copy = 'Copiar código'
      assign pnp_copied = 'Copiado ✓'
      assign pnp_shop = 'Ver la tienda'
      assign pnp_valid = 'Válido una vez por cliente. Se aplica en el checkout.'
      assign pnp_kicker = 'Únete a la nube'
      assign pnp_t = 'Novedades y ofertas exclusivas'
      assign pnp_t_bw = 'Te avisamos cuando empiece la Black Week'
      assign pnp_p = 'Suscríbete a la newsletter y recibe novedades y ofertas exclusivas, además de ideas para los primeros años de tu bebé.'
      assign pnp_p_bw = 'Del 24 al 30 de noviembre: −20% en casi toda la tienda y −40% en los PDF. Deja tu email y te avisamos el mismo día, con novedades e ideas para los primeros años de tu bebé.'
      assign pnp_ph = 'Tu email'
      assign pnp_btn = 'Suscribirme'
      assign pnp_btn_bw = 'Avisadme'
      assign pnp_legal = 'Al suscribirte, aceptas recibir emails de Petit Nuvem. Puedes darte de baja en cualquier momento.'
      assign pnp_privacy = 'Política de privacidad'
      assign pnp_no = 'Ahora no'
    else
      assign pnp_close = 'Fechar'
      assign pnp_ok_t = 'Bem-vinda à nuvem!'
      assign pnp_ok_p = 'Obrigada por subscreveres. Enviamos-te novidades e ofertas exclusivas.'
      assign pnp_ok_bw = 'Está combinado: avisamos-te por email quando a Black Week começar, a 24 de novembro. Até lá já tens −15% em quase toda a loja e −30% nos PDF, aplicado no saco.'
      assign pnp_copy = 'Copiar código'
      assign pnp_copied = 'Copiado ✓'
      assign pnp_shop = 'Ver a loja'
      assign pnp_valid = 'Válido uma vez por cliente. Aplica-se no checkout.'
      assign pnp_kicker = 'Junta-te à nuvem'
      assign pnp_t = 'Novidades e ofertas exclusivas'
      assign pnp_t_bw = 'Avisamos-te quando a Black Week começar'
      assign pnp_p = 'Subscreve a newsletter e recebe novidades e ofertas exclusivas, e ideias para os primeiros anos do teu bebé.'
      assign pnp_p_bw = 'De 24 a 30 de novembro: −20% em quase toda a loja e −40% nos PDF. Deixa o teu email e avisamos-te no próprio dia, com novidades e ideias para os primeiros anos do teu bebé.'
      assign pnp_ph = 'O teu email'
      assign pnp_btn = 'Subscrever'
      assign pnp_btn_bw = 'Avisem-me'
      assign pnp_legal = 'Ao subscrever aceitas receber emails da Petit Nuvem. Podes cancelar a qualquer momento.'
      assign pnp_privacy = 'Política de privacidade'
      assign pnp_no = 'Agora não'
  endcase
-%}
{%- unless pnp_skip -%}
<style>
  .pnp{border:0;padding:0;margin:auto;max-width:min(92vw,420px);width:100%;border-radius:22px;background:var(--paper,#fbf7f2);color:#4a3b33;box-shadow:0 24px 60px rgba(60,40,30,.25);overflow:hidden;font:inherit}
  .pnp::backdrop{background:rgba(60,45,38,.45);backdrop-filter:blur(2px)}
  .pnp__in{padding:34px 26px 24px;text-align:center;position:relative}
  .pnp__x{position:absolute;top:10px;right:10px;width:40px;height:40px;border:0;background:transparent;font-size:26px;line-height:1;color:#7a685d;cursor:pointer;border-radius:50%}
  .pnp__x:focus-visible,.pnp button:focus-visible,.pnp input:focus-visible{outline:2px solid #b98a6b;outline-offset:2px}
  .pnp__cloud{font-size:40px;line-height:1;margin-bottom:6px}
  .pnp__kicker{letter-spacing:.14em;text-transform:uppercase;font-size:12px;color:#9a7f6e;margin:0 0 6px}
  .pnp__t{font-size:clamp(24px,6vw,30px);line-height:1.15;margin:0 0 10px;font-weight:600}
  .pnp__p{margin:0 0 18px;font-size:15px;line-height:1.5;color:#6b5a50}
  .pnp__row{display:flex;flex-direction:column;gap:10px}
  .pnp__row input{width:100%;box-sizing:border-box;padding:14px 16px;border:1px solid #e3d6cb;border-radius:999px;background:#fff;font:inherit;font-size:16px;color:#4a3b33}
  .pnp__btn{padding:14px 18px;border:0;border-radius:999px;background:#4a3b33;color:#fff;font:inherit;font-size:15px;font-weight:600;cursor:pointer}
  .pnp__btn:hover{background:#2f2520}
  .pnp__small{display:block;margin-top:12px;font-size:11.5px;line-height:1.45;color:#8f7d71}
  .pnp__small a{color:inherit}
  .pnp__no{margin-top:10px;background:none;border:0;color:#8f7d71;font:inherit;font-size:13px;text-decoration:underline;cursor:pointer}
  .pnp__err{color:#a23b2a;font-size:13px;margin:0 0 10px}
  .pnp [hidden]{display:none!important}
  .pnp__code{display:flex;align-items:center;justify-content:center;gap:10px;margin:4px 0 14px;padding:14px;border:2px dashed #c9a58c;border-radius:14px;background:#fff;font-size:22px;font-weight:700;letter-spacing:.12em}
  .pnp__expand{display:none}
  @media (prefers-reduced-motion:no-preference){.pnp[open]{animation:pnpIn .35s cubic-bezier(.2,.8,.2,1)}@keyframes pnpIn{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:none}}}
  /* 10/11 noite: barra compacta ≤640px — não tapa a grelha. dialog com pointer-events:none; só o cartão recebe toques. */
  @media (max-width:640px){
    .pnp{
      margin:0;
      max-width:100%;
      width:100%;
      max-height:none;
      height:auto;
      border-radius:16px 16px 0 0;
      position:fixed;
      left:0;right:0;bottom:0;
      top:auto;
      box-shadow:0 -8px 28px rgba(60,40,30,.18);
      z-index:40;
      background:transparent;
      overflow:visible;
      pointer-events:none;
      animation:none;
    }
    .pnp::backdrop{display:none}
    .pnp__in{
      pointer-events:auto;
      margin:0;
      max-height:120px;
      padding:10px 44px 10px 14px;
      border-radius:16px 16px 0 0;
      background:var(--paper,#fbf7f2);
      box-shadow:0 -8px 28px rgba(60,40,30,.18);
      text-align:left;
      overflow:hidden;
    }
    .pnp.is-pnp-open .pnp__in{max-height:120px}
    .pnp.is-pnp-expanded .pnp__in{max-height:min(70vh,520px);overflow:auto;padding:16px 44px 14px 14px;text-align:center}
    .pnp__x{top:6px;right:6px;width:36px;height:36px;z-index:2}
    .pnp__cloud,.pnp__kicker,.pnp__p,.pnp__small,.pnp__no,.pnp__code{display:none}
    .pnp.is-pnp-expanded .pnp__cloud,.pnp.is-pnp-expanded .pnp__kicker,.pnp.is-pnp-expanded .pnp__p,.pnp.is-pnp-expanded .pnp__small,.pnp.is-pnp-expanded .pnp__no,.pnp.is-pnp-expanded .pnp__code{display:block}
    .pnp.is-pnp-expanded .pnp__code{display:flex}
    .pnp__t{font-size:14px;line-height:1.25;margin:0 0 8px;font-weight:600;cursor:pointer}
    .pnp.is-pnp-expanded .pnp__t{font-size:22px;margin:0 0 10px;cursor:default}
    .pnp__row{flex-direction:row;align-items:center;gap:8px}
    .pnp__row input{flex:1;min-width:0;padding:10px 12px;font-size:15px}
    .pnp__btn{padding:10px 14px;font-size:13px;white-space:nowrap;flex-shrink:0}
    .pnp.is-pnp-expanded .pnp__row{flex-direction:column}
    .pnp.is-pnp-expanded .pnp__row input,.pnp.is-pnp-expanded .pnp__btn{width:100%;padding:12px 16px}
    .pnp__expand{display:none}
    body.pnp-bar-open{padding-bottom:128px !important}
    /* 22/11 (scroll preso): o theme.css tem body:has(dialog[open]){overflow:hidden}, que bloqueava o scroll da página com esta folha (não modal) aberta. Aqui a página continua a rolar, a não ser que haja outra janela aberta. */
    body:has(#PnPopupNews[open]):not(:has(dialog[open]:not(#PnPopupNews))){overflow:visible}
    /* 16/11: quando a barra de compra está visível, a folha sobe e fica à frente, sem tapar o botão. */
    .pnp.pnp-acima-barra{
      z-index:50;
      bottom:var(--pn-barra-h, calc(84px + env(safe-area-inset-bottom, 0px)));
    }
    .pnp.pnp-acima-barra.is-pnp-expanded .pnp__in{
      max-height:min(calc(70vh - var(--pn-barra-h, 84px)), 520px);
    }
  }
</style>
<dialog class="pnp" id="PnPopupNews" aria-labelledby="PnPopupNewsT">
  <div class="pnp__in">
    <button type="button" class="pnp__x" data-pnp-close aria-label="{{ pnp_close | escape }}">×</button>
    {%- form 'customer', id: 'PnPopupNewsForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,popup-10" data-pnp-tags>
      {%- if form.posted_successfully? -%}
        <div class="pnp__cloud" aria-hidden="true">☁️</div>
        <h2 class="pnp__t" id="PnPopupNewsT" data-pnp-toggle>{{ pnp_ok_t }}</h2>
        <p class="pnp__p" data-pnp-std>{{ pnp_ok_p }}</p>
        <p class="pnp__p" data-pnp-bw hidden>{{ pnp_ok_bw }}</p>
        <a class="pnp__btn" href="{{ routes.all_products_collection_url }}" style="display:block;margin-top:10px;background:transparent;color:#4a3b33;border:1px solid #4a3b33;text-decoration:none">{{ pnp_shop }}</a>
        <span data-pnp-ok hidden></span>
      {%- else -%}
        <div class="pnp__cloud" aria-hidden="true">☁️</div>
        <p class="pnp__kicker">{{ pnp_kicker }}</p>
        <h2 class="pnp__t" id="PnPopupNewsT" data-pnp-toggle><span data-pnp-std>{{ pnp_t }}</span><span data-pnp-bw hidden>{{ pnp_t_bw }}</span></h2>
        <p class="pnp__p" data-pnp-std>{{ pnp_p }}</p>
        <p class="pnp__p" data-pnp-bw hidden>{{ pnp_p_bw }}</p>
        {%- if form.errors -%}<p class="pnp__err" role="alert" data-pnp-err>{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="pnp__row">
          <label for="PnPopupEmail" class="visually-hidden">Email</label>
          <input id="PnPopupEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ pnp_ph | escape }}">
          <button type="submit" class="pnp__btn"><span data-pnp-std>{{ pnp_btn }}</span><span data-pnp-bw hidden>{{ pnp_btn_bw }}</span></button>
        </div>
        <span class="pnp__small">{{ pnp_legal }}{% if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">{{ pnp_privacy }}</a>.{% endif %}</span>
        <button type="button" class="pnp__no" data-pnp-close>{{ pnp_no }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</dialog>
<script>
(function(){
  var d=document.getElementById('PnPopupNews'); if(!d||typeof d.showModal!=='function') return;
  var now=Date.now(), bw=now>=Date.UTC(2026,10,10)&&now<Date.UTC(2026,11,1);
  if(/[?&]pn_campanha=(nov|bw)/.test(location.search)) bw=true;
  if(bw){ d.querySelectorAll('[data-pnp-std]').forEach(function(e){e.hidden=true}); d.querySelectorAll('[data-pnp-bw]').forEach(function(e){e.hidden=false}); var tg=d.querySelector('[data-pnp-tags]'); if(tg) tg.value='newsletter,popup-blackweek'; }
  var K=bw?'pnPopupNewsBW':'pnPopupNews', DAYS=14;
  var mobile=function(){ return window.matchMedia && window.matchMedia('(max-width:640px)').matches; };
  function get(){try{return JSON.parse(localStorage.getItem(K)||'null')}catch(e){return null}}
  function set(v){try{localStorage.setItem(K,JSON.stringify(v))}catch(e){}}
  function syncBodyPad(){
    if(mobile() && d.open) document.body.classList.add('pnp-bar-open');
    else document.body.classList.remove('pnp-bar-open');
  }
  function syncBarra(){
    var b=mobile()?document.querySelector('.pn-barra.is-on'):null;
    var h=0;
    if(b) h=Math.ceil(b.getBoundingClientRect().height)+8;
    if(h>0){ d.style.setProperty('--pn-barra-h',h+'px'); d.classList.add('pnp-acima-barra'); }
    else { d.style.removeProperty('--pn-barra-h'); d.classList.remove('pnp-acima-barra'); }
  }
  var barraObs=null;
  function watchBarra(){
    syncBarra();
    var b=document.querySelector('.pn-barra');
    if(!b||typeof MutationObserver!=='function'||barraObs) return;
    barraObs=new MutationObserver(syncBarra);
    barraObs.observe(b,{attributes:true,attributeFilter:['class']});
  }
  watchBarra();
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',watchBarra);
  setTimeout(watchBarra,500);
  window.addEventListener('resize',syncBarra,{passive:true});
  function open(){
    if(d.open) return;
    if(mobile()){
      if(document.querySelector('dialog[open]:not(#PnPopupNews)')) return;
      d.classList.add('is-pnp-open');
      d.classList.remove('is-pnp-expanded');
      try{ d.show(); }catch(e){ try{d.showModal()}catch(e2){} }
      syncBodyPad();
      syncBarra();
      return;
    }
    if(document.querySelector('dialog[open]')) return;
    d.classList.remove('is-pnp-open');
    d.classList.remove('is-pnp-expanded');
    try{d.showModal()}catch(e){}
  }
  function close(){ d.close(); }
  d.addEventListener('close',function(){
    d.classList.remove('is-pnp-open');
    d.classList.remove('is-pnp-expanded');
    document.body.classList.remove('pnp-bar-open');
    syncBarra();
    var s=get()||{}; if(!s.sub){ s.t=Date.now(); set(s);}
  });
  d.addEventListener('click',function(e){ if(e.target===d) close(); });
  d.querySelectorAll('[data-pnp-close]').forEach(function(b){ b.addEventListener('click',close); });
  /* No telemóvel, tocar no título expande a barra (opcional). */
  d.querySelectorAll('[data-pnp-toggle]').forEach(function(t){
    t.addEventListener('click',function(e){
      if(!mobile() || !d.open) return;
      if(d.classList.contains('is-pnp-expanded')) return;
      e.preventDefault();
      d.classList.add('is-pnp-expanded');
      syncBarra();
    });
  });
  var cp=d.querySelector('[data-pnp-copy]');
  if(cp){ cp.addEventListener('click',function(){ var c=document.getElementById('PnPopupCode').textContent.trim();
    var ok=cp.getAttribute('data-pnp-copied-label')||'Copied ✓';
    if(navigator.clipboard){navigator.clipboard.writeText(c).then(function(){cp.textContent=ok},function(){cp.textContent=c})} else {cp.textContent=c} }); }
  var forced=/[?&]popup=teste/.test(location.search);
  if(d.querySelector('[data-pnp-ok]')){ set({sub:1,t:Date.now()}); setTimeout(function(){ open(); },300); return; }
  if(d.querySelector('[data-pnp-err]')){ setTimeout(function(){ open(); },300); return; }
  if(forced){ setTimeout(open,800); return; }
  if(bw){ try{ var o=JSON.parse(localStorage.getItem('pnPopupNews')||'null'); if(o&&o.sub) return; }catch(e){} }
  var s=get(); if(s&&(s.sub||(Date.now()-s.t)<DAYS*864e5)) return;
  var done=false; function go(){ if(done) return; done=true; window.removeEventListener('scroll',onS);
  /* 11/11 (auditoria): enquanto a «Caça à nuvem» estiver a decorrer (até ao data-fim do #pnJogo, 15/11), a janela do jogo é a única da visita: a newsletter não abre. Depois volta ao normal sozinha. */
  try{ var pj=document.getElementById('pnJogo'), pf=pj&&Date.parse((pj.getAttribute('data-fim')||'')+':59Z'); if(pj&&document.getElementById('pnJogoInicio')&&pf&&Date.now()<pf) return; }catch(e){}
  open(); if(!d.open){ done=false; setTimeout(go,8000); } }
  function onS(){ var h=document.documentElement; if((h.scrollTop+innerHeight)/h.scrollHeight>0.5) go(); }
  setTimeout(go, mobile()?22000:15000); window.addEventListener('scroll',onS,{passive:true});
})();
</script>
{%- endunless -%}
