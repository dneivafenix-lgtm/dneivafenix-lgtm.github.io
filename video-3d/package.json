{
  "name": "video-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Vídeos animados em 3D com Three.js (React Three Fiber) e Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render HistoriaDemo out/historia-demo.mp4",
    "render:short": "remotion render HistoriaShort out/historia-short.mp4",
    "render:sem-gpu": "remotion render HistoriaDemo out/historia-demo.mp4 --gl=swangle",
    "thumbnail": "remotion still HistoriaDemo out/thumbnail.png --frame=60",
    "legendas": "node scripts/transcrever.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/install-whisper-cpp": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/three": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
